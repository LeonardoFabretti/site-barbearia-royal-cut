# Copie este arquivo para .env e preencha com os dados do seu projeto no Supabase
# (botão Connect → ORM → Prisma). O .env nunca deve ir para o GitHub.

# Conexão do site (pooler, porta 6543)
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432), usada pelo Prisma (npx prisma db pull)
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Senha da página /agenda do profissional. Obrigatória no site publicado;
# sem ela, a agenda só abre no computador (npm run dev).
AGENDA_SENHA=""
